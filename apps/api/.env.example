# Copy this file to ".env" and fill in real values. Never commit ".env".

# --- Database (Neon) ---
# Get this from https://console.neon.tech → your project → Connection Details →
# "Connection string" (choose the "Pooled connection", Prisma-compatible).
# It looks like:
# postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- API server ---
PORT=4000
WEB_ORIGIN="http://localhost:5180"

# --- Auth ---
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"

# --- File storage (local disk for dev; swap for S3/R2 in prod) ---
UPLOAD_DIR="./uploads"

# --- WhatsApp (Meta Cloud API) — optional. Leave blank to run in log-only
# mock mode (every send is logged, nothing goes out). Get these from
# Meta Business Manager → WhatsApp → API Setup:
#   WHATSAPP_ACCESS_TOKEN   — permanent access token for your app
#   WHATSAPP_PHONE_NUMBER_ID — the sending number's phone_number_id
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v21.0"
