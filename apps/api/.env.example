# Copy this file to ".env" and fill in real values. Never commit ".env".

# --- Database (Neon) ---
# Get this from https://console.neon.tech → your project → Connection Details →
# "Connection string" (choose the "Pooled connection", Prisma-compatible).
# It looks like:
# postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- API server ---
PORT=4000
WEB_ORIGIN="http://localhost:5180"

# --- Auth ---
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"

# --- File storage (local disk for dev; swap for S3/R2 in prod) ---
UPLOAD_DIR="./uploads"
