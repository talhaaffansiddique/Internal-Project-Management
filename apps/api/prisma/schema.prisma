// OpsHub database schema
// Phase 1.0.2 — core foundation: people & org, master data, shared building blocks.
// Module tables (tickets, projects, meetings, training, procurement) come in later phases
// and will reference these via the polymorphic (entityType, entityId) pair.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Enums
// ============================================================

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

/// Records that shared building blocks (comments, followers, attachments,
/// activities, audit, notifications) can attach to.
enum EntityType {
  TICKET
  PROJECT
  TASK
  MEETING
  TRAINING
  PROCUREMENT_REQUEST
}

enum ActivityStatus {
  OPEN
  DONE
  CANCELLED
}

enum TicketVisibility {
  PRIVATE
  TEAM
}

enum MeetingResponse {
  PENDING
  ACCEPTED
  DECLINED
  TENTATIVE
}

enum TrainingType {
  INDIVIDUAL
  GROUP
}

enum TrainingAck {
  PENDING
  CONFIRMED
  NEEDS_FOLLOW_UP
}

enum ProcurementType {
  PRODUCT
  SERVICE
}

enum ProcurementStatus {
  SUBMITTED
  AWAITING_DIRECTOR
  WITH_PURCHASING
  ORDERED
  DELIVERED
  REJECTED
}

enum QuotationStatus {
  PENDING
  SELECTED
  REJECTED
}

enum NotificationType {
  MENTION
  ASSIGNMENT
  MEETING_INVITATION
  MEETING_REMINDER
  APPROVAL_REQUEST
  TRAINING_ACK
  ACTIVITY_DUE
  STATUS_CHANGE
  GENERAL
}

// ============================================================
// People & organization
// ============================================================

model User {
  id                  String     @id @default(uuid())
  email               String     @unique
  passwordHash        String
  fullName            String
  status              UserStatus @default(INVITED)
  designationId       String?
  primaryDepartmentId String?
  supervisorId        String?
  lastLoginAt         DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  designation       Designation? @relation(fields: [designationId], references: [id])
  primaryDepartment Department?  @relation("DepartmentMembers", fields: [primaryDepartmentId], references: [id])
  supervisor        User?        @relation("UserSupervisor", fields: [supervisorId], references: [id])
  reports           User[]       @relation("UserSupervisor")

  roles               UserRole[]
  teamMemberships     TeamMember[]
  attachmentsUploaded Attachment[]
  comments            Comment[]
  commentMentions     CommentMention[]
  following           Follower[]       @relation("FollowerUser")
  followersAdded      Follower[]       @relation("FollowerAddedBy")
  activitiesAssigned  Activity[]       @relation("ActivityAssignee")
  activitiesCreated   Activity[]       @relation("ActivityCreator")
  auditEntries        AuditLog[]
  notifications       Notification[]
  ticketsRequested    Ticket[]         @relation("TicketRequester")
  ticketsAssigned     Ticket[]         @relation("TicketAssignee")
  ticketsClosed       Ticket[]         @relation("TicketClosedBy")
  projectsOwned       Project[]        @relation("ProjectOwner")
  projectMemberships  ProjectMember[]
  tasksAssigned       Task[]           @relation("TaskAssignee")
  tasksCreated        Task[]           @relation("TaskCreator")
  meetingsOrganized   Meeting[]        @relation("MeetingOrganizer")
  meetingParticipations MeetingParticipant[]
  trainingsAsTrainer  Training[]       @relation("TrainingTrainer")
  trainingsCreated    Training[]       @relation("TrainingCreator")
  trainingParticipations TrainingParticipant[]
  procurementRequested ProcurementRequest[] @relation("ProcurementRequester")
  procurementQuotationsAdded ProcurementQuotation[]

  @@index([primaryDepartmentId])
  @@index([supervisorId])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  rank        Int      @default(0)
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())

  users UserRole[]

  @@map("roles")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String?  @unique
  active    Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members             User[]               @relation("DepartmentMembers")
  teams               Team[]
  procurementRequests ProcurementRequest[]

  @@map("departments")
}

model Team {
  id           String   @id @default(uuid())
  name         String   @unique
  departmentId String?
  description  String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department?  @relation(fields: [departmentId], references: [id])
  members    TeamMember[]
  tickets    Ticket[]

  @@index([departmentId])
  @@map("teams")
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  userId    String
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_members")
}

model Designation {
  id        String   @id @default(uuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  @@map("designations")
}

model Branch {
  id        String   @id @default(uuid())
  name      String   @unique
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("branches")
}

// ============================================================
// Master data — configurable values (brief §5.1)
// Super Admin adds values here with no code change.
// ============================================================

model MasterDataType {
  id              String   @id @default(uuid())
  key             String   @unique
  name            String
  description     String?
  allowsHierarchy Boolean  @default(false)
  isSystem        Boolean  @default(true)
  createdAt       DateTime @default(now())

  values MasterDataValue[]

  @@map("master_data_types")
}

model MasterDataValue {
  id        String   @id @default(uuid())
  typeId    String
  key       String
  label     String
  parentId  String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  isSystem  Boolean  @default(false)
  meta      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  type     MasterDataType    @relation(fields: [typeId], references: [id], onDelete: Cascade)
  parent   MasterDataValue?  @relation("MasterDataValueChildren", fields: [parentId], references: [id])
  children MasterDataValue[] @relation("MasterDataValueChildren")

  @@unique([typeId, key])
  @@index([typeId, active])
  @@map("master_data_values")
}

// ============================================================
// Shared building blocks — attach to any record via (entityType, entityId)
// ============================================================

model Attachment {
  id               String      @id @default(uuid())
  entityType       EntityType?
  entityId         String?
  originalFilename String
  storageKey       String
  mimeType         String
  sizeBytes        Int
  uploadedById     String
  createdAt        DateTime    @default(now())

  uploadedBy User @relation(fields: [uploadedById], references: [id])

  @@index([entityType, entityId])
  @@map("attachments")
}

model Comment {
  id         String     @id @default(uuid())
  entityType EntityType
  entityId   String
  authorId   String
  body       String
  editedAt   DateTime?
  deletedAt  DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  author   User             @relation(fields: [authorId], references: [id])
  mentions CommentMention[]

  @@index([entityType, entityId])
  @@map("comments")
}

model CommentMention {
  id        String @id @default(uuid())
  commentId String
  userId    String

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@map("comment_mentions")
}

model Follower {
  id         String     @id @default(uuid())
  entityType EntityType
  entityId   String
  userId     String
  addedById  String?
  createdAt  DateTime   @default(now())

  user    User  @relation("FollowerUser", fields: [userId], references: [id], onDelete: Cascade)
  addedBy User? @relation("FollowerAddedBy", fields: [addedById], references: [id])

  @@unique([entityType, entityId, userId])
  @@index([userId])
  @@map("followers")
}

/// Follow-ups (brief §10) — an action someone must complete by a due date.
/// Deliberately separate from Comment (chatter).
model Activity {
  id           String         @id @default(uuid())
  title        String
  assignedToId String
  dueAt        DateTime
  entityType   EntityType?
  entityId     String?
  status         ActivityStatus @default(OPEN)
  completedAt    DateTime?
  lastRemindedAt DateTime?
  createdById    String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  assignedTo User @relation("ActivityAssignee", fields: [assignedToId], references: [id])
  createdBy  User @relation("ActivityCreator", fields: [createdById], references: [id])

  @@index([assignedToId, status])
  @@index([entityType, entityId])
  @@map("activities")
}

/// Append-only audit trail (brief §17). Never updated, never silently overwritten.
model AuditLog {
  id         String     @id @default(uuid())
  entityType EntityType
  entityId   String
  action     String
  summary    String
  actorId    String?
  oldValue   Json?
  newValue   Json?
  meta       Json?
  createdAt  DateTime   @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_log")
}

model Notification {
  id          String           @id @default(uuid())
  recipientId String
  type        NotificationType
  title       String
  body        String?
  entityType  EntityType?
  entityId    String?
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  recipient User @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt])
  @@map("notifications")
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

// ============================================================
// Tickets & Requests (brief §8)
// ============================================================

model Ticket {
  id           String           @id @default(uuid())
  number       Int              @unique @default(autoincrement())
  subject      String
  type         String // master-data key: erp_issue, it_issue, training_request, ...
  description  String?
  fields       Json? // conditional-form answers, shape depends on `type`
  visibility   TicketVisibility @default(PRIVATE)
  teamId       String?
  statusKey    String           @default("new") // master-data key
  categoryId   String? // master_data_value id (ticket_categories)
  requesterId  String
  assigneeId   String?
  closedById   String?
  closedAt     DateTime?
  reopenReason String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  team      Team? @relation(fields: [teamId], references: [id])
  requester User  @relation("TicketRequester", fields: [requesterId], references: [id])
  assignee  User? @relation("TicketAssignee", fields: [assigneeId], references: [id])
  closedBy  User? @relation("TicketClosedBy", fields: [closedById], references: [id])

  @@index([statusKey])
  @@index([requesterId])
  @@index([assigneeId])
  @@index([teamId])
  @@map("tickets")
}

// ============================================================
// Projects & Tasks (brief §11)
// ============================================================

model Project {
  id          String   @id @default(uuid())
  number      Int      @unique @default(autoincrement())
  title       String
  type        String // master-data key: project_types
  description String?
  ownerId     String
  statusKey   String   @default("planned") // master-data key: project_statuses
  startDate   DateTime?
  targetDate  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner    User            @relation("ProjectOwner", fields: [ownerId], references: [id])
  members  ProjectMember[]
  tasks    Task[]
  meetings Meeting[]

  @@index([statusKey])
  @@index([ownerId])
  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

model Task {
  id           String   @id @default(uuid())
  number       Int      @unique @default(autoincrement())
  projectId    String
  parentTaskId String?
  title        String
  description  String?
  assigneeId   String?
  statusKey    String   @default("todo") // master-data key: task_statuses
  dueDate      DateTime?
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent     Task?   @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks   Task[]  @relation("TaskSubtasks")
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdBy  User    @relation("TaskCreator", fields: [createdById], references: [id])

  @@index([projectId])
  @@index([assigneeId])
  @@index([statusKey])
  @@map("tasks")
}

// ============================================================
// Meetings & Calendar (brief §12)
// ============================================================

model Meeting {
  id             String   @id @default(uuid())
  number         Int      @unique @default(autoincrement())
  title          String
  agenda         String?
  startsAt       DateTime
  endsAt         DateTime
  organizerId    String
  location       String?
  onlineLink     String?
  projectId      String?
  minutes        String?
  lastRemindedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organizer    User                 @relation("MeetingOrganizer", fields: [organizerId], references: [id])
  project      Project?             @relation(fields: [projectId], references: [id])
  participants MeetingParticipant[]

  @@index([startsAt])
  @@index([organizerId])
  @@map("meetings")
}

model MeetingParticipant {
  id          String          @id @default(uuid())
  meetingId   String
  userId      String
  response    MeetingResponse @default(PENDING)
  respondedAt DateTime?
  attended    Boolean         @default(false)
  createdAt   DateTime        @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@map("meeting_participants")
}

// ============================================================
// Training Management (brief §13)
// ============================================================

model Training {
  id             String       @id @default(uuid())
  number         Int          @unique @default(autoincrement())
  topic          String
  description    String?
  categoryKey    String? // master-data key: training_categories
  type           TrainingType @default(GROUP)
  trainerId      String
  scheduledAt    DateTime?
  statusKey      String       @default("requested") // master-data key: training_statuses
  completedAt    DateTime?
  lastRemindedAt DateTime?
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  trainer      User                    @relation("TrainingTrainer", fields: [trainerId], references: [id])
  createdBy    User                    @relation("TrainingCreator", fields: [createdById], references: [id])
  participants TrainingParticipant[]
  checklist    TrainingChecklistItem[]

  @@index([statusKey])
  @@index([trainerId])
  @@map("trainings")
}

model TrainingParticipant {
  id         String      @id @default(uuid())
  trainingId String
  userId     String
  ackStatus  TrainingAck @default(PENDING)
  ackAt      DateTime?
  ackComment String?
  createdAt  DateTime    @default(now())

  training Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([trainingId, userId])
  @@map("training_participants")
}

model TrainingChecklistItem {
  id         String    @id @default(uuid())
  trainingId String
  label      String
  done       Boolean   @default(false)
  doneAt     DateTime?
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())

  training Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  @@map("training_checklist_items")
}

// ============================================================
// Procurement (brief §14)
// ============================================================

model ProcurementRequest {
  id             String            @id @default(uuid())
  number         Int               @unique @default(autoincrement())
  businessReason String
  requesterId    String
  departmentId   String?
  statusKey      ProcurementStatus @default(SUBMITTED)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  requester  User                   @relation("ProcurementRequester", fields: [requesterId], references: [id])
  department Department?            @relation(fields: [departmentId], references: [id])
  items      ProcurementItem[]
  quotations ProcurementQuotation[]

  @@index([statusKey])
  @@index([requesterId])
  @@map("procurement_requests")
}

/// One line item (product or service) within a procurement request — a
/// request can bundle several, each with its own type and quantity.
model ProcurementItem {
  id          String          @id @default(uuid())
  requestId   String
  type        ProcurementType
  description String
  quantity    String?
  createdAt   DateTime        @default(now())

  request ProcurementRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("procurement_items")
}

model ProcurementQuotation {
  id             String          @id @default(uuid())
  requestId      String
  vendorName     String
  amount         Float
  quotationDate  DateTime?
  validUntil     DateTime?
  paymentTerms   String?
  deliveryTime   String?
  comments       String?
  attachmentId   String?
  status         QuotationStatus @default(PENDING)
  createdById    String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  request   ProcurementRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  createdBy User               @relation(fields: [createdById], references: [id])

  @@index([requestId])
  @@map("procurement_quotations")
}
